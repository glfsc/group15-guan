APP_NAME=TOEIC Learning App
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/toeic_app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=toeic_app
DB_USER=postgres
DB_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

MAAS_ENDPOINT=https://maas.cn-north-4.myhuaweicloud.com
MAAS_AK=your_access_key
MAAS_SK=your_secret_key
MAAS_MODEL=glm-4
MAAS_API_KEY=your_maas_api_key
MAAS_IMAGE_ENDPOINT=https://api.modelarts-maas.com/v1/images/generations
MAAS_IMAGE_API_KEY=your_maas_api_key
MAAS_IMAGE_MODEL=qwen-image
MAAS_IMAGE_SIZE=1024x1024
MAAS_IMAGE_QUALITY=standard
MAAS_IMAGE_RESPONSE_FORMAT=b64_json
MAAS_IMAGE_SEED=1

OBS_BUCKET=toeic-audio-files
OBS_REGION=cn-north-4
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_AK=your_access_key
OBS_SK=your_secret_key

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
